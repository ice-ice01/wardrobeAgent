# Local Compose defaults are sufficient for Mock mode. Replace every secret before deployment.
WARDROBE_HTTP_PORT=8088
WARDROBE_DB_PASSWORD=wardrobe_local_password
MYSQL_ROOT_PASSWORD=wardrobe_root_local_password
WARDROBE_JWT_SECRET=replace-with-at-least-64-random-characters-before-deploying

AI_MODE=mock
AI_SEMANTIC_RETRIEVAL_ENABLED=false
AI_MULTIMODAL_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com
# 供应商 Chat API 根地址（可选）；不填写时由 AI_BASE_URL 自动补 /v1。
AI_CHAT_BASE_URL=
AI_MODEL=gpt-4o-mini
# 生图复用 AI_API_KEY 与 AI_BASE_URL，但必须使用支持 Images API 的模型名。
AI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_SIZE=1024x1024
AI_IMAGE_QUALITY=low

# Try-on provider: MOCK, FASHN_V1_6, GPT_IMAGE_EDIT, or SPRING_AI_IMAGE.
TRYON_PROVIDER=MOCK
TRYON_REAL_ENABLED=false
FASHN_API_KEY=
TRYON_SPRING_AI_FALLBACK_ENABLED=false
